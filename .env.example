# Variáveis usadas pelo servidor (defina no painel da hospedagem ou no terminal)

# Senha para acessar o app (vazio = sem login, só use localmente)
APP_PASSWORD=
# Segredo para assinar o token de login (string longa e aleatória)
AUTH_SECRET=
# Postgres. Padrão local = container do docker-compose.
# Produção (ex.: Neon grátis): postgres://user:pass@host/db?sslmode=require
DATABASE_URL=postgres://finances:finances@localhost:5433/finances
PORT=3333
