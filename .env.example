# Senha para acessar o app (vazio = sem login, só use localmente)
APP_PASSWORD=
# Segredo para assinar o token de login (gere uma string longa e aleatória)
AUTH_SECRET=
# Banco: local em arquivo, ou Turso em produção (libsql://xxx.turso.io)
DATABASE_URL=file:./data/finances.db
DATABASE_AUTH_TOKEN=
PORT=3333
